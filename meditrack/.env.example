APP_ENV=development
API_PORT=8000
WEB_PORT=3000
DATABASE_URL=postgresql+psycopg://meditrack:meditrack_dev_only@db:5432/meditrack
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-secret-before-running
JWT_ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
# WhatsApp Cloud API — leave blank to use the safe development stub
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
# Optional voice / calling provider credentials (implement provider-specific adapter before enabling)
CALL_PROVIDER=stub
CALL_PROVIDER_API_KEY=
CALL_PROVIDER_FROM_NUMBER=
# Payments: not wired by default; set only after implementing/verifying your payment provider
PAYMENT_PROVIDER=disabled
PAYMENT_API_KEY=

# Private local upload storage (development only; use encrypted private object storage in production)
PRESCRIPTION_UPLOAD_DIR=./private_uploads
PRESCRIPTION_MAX_UPLOAD_MB=10
PRESCRIPTION_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
